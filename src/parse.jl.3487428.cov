       65 function _parse_expression!(parser::_Parser, minimum_precedence::Int)
       65     left = _parse_prefix!(parser)
       62     while true
       62         token = _current(parser)
       62         token.kind == :operator || break
       14         connective = parser.bynotation[token.text]
       14         arity(parser.pool.signature, connective) == 2 || break
       28         p = precedence(connective)
       14         p < minimum_precedence && break
        8         _advance!(parser)
       11         next_minimum = associativity(connective) == :right ? p : p + 1
        8         right = _parse_expression!(parser, next_minimum)
        8         left = branch(parser.pool, connective, left, right)
        8     end
       54     left
        - end
