       28 function _tokenize(source::AbstractString, signature::Signature)
       28     operators = sort!(collect(notation.(signature.connectives)), by=length, rev=true)
       28     tokens = _Token[]
       28     chars = String(source)
       28     i = firstindex(chars)
       55     last = lastindex(chars)
      145     while i <= last
      117         c = chars[i]
      117         if isspace(c)
       30             i = nextind(chars, i)
       15             continue
      102         elseif c == '"'
        2             i = nextind(chars, i)
        1             buffer = IOBuffer()
        1             closed = false
        6             while i <= last
        6                 c = chars[i]
        6                 if c == '"'
        2                     i = nextind(chars, i)
        1                     closed = true
        1                     break
        5                 elseif c == '\\'
        2                     i = nextind(chars, i)
        1                     i <= last || throw(ArgumentError("unterminated quoted atom"))
        1                     escaped = chars[i]
        1                     escaped == '"' || escaped == '\\' || throw(ArgumentError("unsupported escape in quoted atom"))
        1                     print(buffer, escaped)
        -                 else
        4                     print(buffer, c)
        -                 end
       10                 i = nextind(chars, i)
        5             end
        1             closed || throw(ArgumentError("unterminated quoted atom"))
        2             push!(tokens, _Token(:atom, String(take!(buffer))))
        1             continue
      101         elseif c == '('
       12             push!(tokens, _Token(:lparen, "(")); i = nextind(chars, i); continue
       89         elseif c == ')'
        9             push!(tokens, _Token(:rparen, ")")); i = nextind(chars, i); continue
       80         elseif c == ','
        9             push!(tokens, _Token(:comma, ",")); i = nextind(chars, i); continue
        -         end
       71         matched = nothing
       71         for op in operators
      274             startswith(SubString(chars, i, last), op) && (matched = op; break)
      243         end
       71         if matched !== nothing
       31             push!(tokens, _Token(:operator, matched))
       31             i = nextind(chars, i, length(matched))
       31             continue
        -         end
       40         start = i
       80         while i <= last
       64             c = chars[i]
      502             if isspace(c) || c in ('(', ')', ',') || any(op -> startswith(SubString(chars, i, last), op), operators)
       24                 break
        -             end
       80             i = nextind(chars, i)
       40         end
       40         i == start && throw(ArgumentError("cannot tokenize input near $(repr(chars[i:end]))"))
       40         push!(tokens, _Token(:atom, String(chars[start:prevind(chars, i)])))
      117     end
       28     push!(tokens, _Token(:end, ""))
       28     tokens
        - end
