        - """
        -     parse(pool, source; atom_parser=identity)
        - 
        - Parse a formula over the pool's signature.  Atoms are parsed by
        - `atom_parser`, which receives their token text and defaults to returning a
        - `String`; this keeps parsing independent of any semantic or truth-value type.
        - The parser is precedence-aware and accepts both infix binary notation and
        - prefix/function notation for higher-arity connectives.
        - """
       56 function parse(pool::FormulaPool, source::AbstractString; atom_parser=identity)
       28     bynotation = Dict{String,Any}()
       28     for connective in pool.signature.connectives
      184         text = notation(connective)
      184         haskey(bynotation, text) && throw(ArgumentError("duplicate connective notation $(repr(text))"))
      184         bynotation[text] = connective
      153     end
       28     parser = _Parser(_tokenize(source, pool.signature), 1, pool, bynotation, atom_parser)
       28     result = _parse_expression!(parser, 0)
       18     _current(parser).kind == :end || throw(ArgumentError("unexpected token $(repr(_current(parser).text))"))
       18     result
        - end
