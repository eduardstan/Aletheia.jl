       65 function _parse_prefix!(parser::_Parser)
       65     token = _advance!(parser)
       65     if token.kind == :atom
       38         return atom(parser.pool, parser.atom_parser(token.text))
       27     elseif token.kind == :lparen
        2         result = _parse_expression!(parser, 0)
        1         _current(parser).kind == :rparen || throw(ArgumentError("expected ')'"))
        1         _advance!(parser)
        1         return result
       25     elseif token.kind == :operator
       23         connective = parser.bynotation[token.text]
       23         n = arity(parser.pool.signature, connective)
       23         if n == 0
        3             if _current(parser).kind == :lparen
        3                 _advance!(parser)
        4                 _current(parser).kind == :rparen || throw(ArgumentError("expected ')' after nullary connective"))
        2                 _advance!(parser)
        -             end
        2             return branch(parser.pool, connective)
       20         elseif n == 1
        -             # A parenthesized unary call is accepted as well as prefix notation.
       15             if _current(parser).kind == :lparen
        3                 _advance!(parser)
        3                 child = _parse_expression!(parser, 0)
        5                 _current(parser).kind == :rparen || throw(ArgumentError("expected ')' after unary connective"))
        1                 _advance!(parser)
        -             else
       12                 child = _parse_expression!(parser, precedence(connective))
        -             end
       13             return branch(parser.pool, connective, child)
        -         else
        6             _current(parser).kind == :lparen ||
        -                 throw(ArgumentError("connective $(repr(token.text)) with arity $n needs function notation"))
        4             _advance!(parser)
        4             parsed = Any[]
        4             if _current(parser).kind != :rparen
       12                 while true
       12                     push!(parsed, _parse_expression!(parser, 0))
       12                     _current(parser).kind == :comma || break
        8                     _advance!(parser)
        8                 end
        -             end
        5             _current(parser).kind == :rparen || throw(ArgumentError("expected ')' after connective arguments"))
        3             _advance!(parser)
        5             length(parsed) == n || throw(ArgumentError("connective $(repr(token.text)) expects $n arguments"))
        1             return branch(parser.pool, connective, Tuple(parsed))
        -         end
        -     end
        2     throw(ArgumentError("unexpected token $(repr(token.text))"))
        - end
