        - """Return whether a clause is a Horn clause (Muggleton & De Raedt, §3.2 [muggleton1994](@cite))."""
        5 ishorn(clause::Clause) = count(literal -> literal.positive, clause.literals) <= 1
        - ishorn(::HornClause) = true
