        - intentionally incomplete: no complete generalization operator exists for full
        - clausal logic without a language bias because θ-subsumption has infinite
        - chains (Muggleton & De Raedt (1994), §5.2.2).
        - """
        3 function upward_refinements(clause::Union{Clause,HornClause})
        3     base = clause isa HornClause ? clause.clause : clause
        3     deletions = (Clause(tuple((base.literals[j] for j in eachindex(base.literals) if j != i)...)) for i in eachindex(base.literals))
        3     terms = Any[]
        3     for literal in base
        7         for term in _clause_terms(literal.atom)
       12             term isa Variable || any(existing -> isequal(existing, term), terms) || push!(terms, term)
        7         end
        6     end
        3     generalizations = (Clause(tuple((_replace_term(literal, term, _fresh_variable(base, i))
        -                                    for literal in base)...)) for (i, term) in enumerate(terms))
       10     _UniqueIterator(Iterators.filter(candidate -> _proper_generalization(base, candidate),
        -         Iterators.flatten((deletions, generalizations))))
        - end
        - 
        - const downward_refinement = downward_refinements
        - const upward_refinement = upward_refinements
        - const specializations = downward_refinements
        - const generalizations = upward_refinements
