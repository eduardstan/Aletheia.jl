        - """Check a class axiom in a particular model at every world."""
       10 function validates(model::Model, formula::Formula)
       11     all(check(formula, model, world) == top(algebra(model)) for world in worlds(frame(model)))
        - end
        1 validates(formula::Formula, model::Model) = validates(model, formula)
