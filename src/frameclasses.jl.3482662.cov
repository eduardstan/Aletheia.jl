       21 function _primitive_axioms(pool::FormulaPool, condition::Symbol, relation, atom_value)
       21     p = _axiom_atom(pool, atom_value)
       21     box = Box(relation); diamond = Diamond(relation)
       21     if condition === :reflexive
        8         _require_connective(pool, box); _require_connective(pool, IMPLICATION)
