        - """Check reflexivity of a named accessibility relation on a finite frame."""
        8 function isreflexive(frame::Frame, relation=nothing)
       15     targets = _class_targets(frame, relation)
       79     !isempty(targets) && all(all(w -> any(v -> isequal(v, w), accessible(frame, w, r)), worlds(frame)) for r in targets)
        - end
