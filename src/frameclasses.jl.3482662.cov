        - # Natural-language aliases.
        1 reflexive(frame, relation=nothing) = isreflexive(frame, relation)
        1 transitive(frame, relation=nothing) = istransitive(frame, relation)
        1 symmetric(frame, relation=nothing) = issymmetric(frame, relation)
        1 serial(frame, relation=nothing) = isserial(frame, relation)
