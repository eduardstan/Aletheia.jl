        - """Check seriality of a named accessibility relation on a finite frame."""
        3 function isserial(frame::Frame, relation=nothing)
        6     targets = _class_targets(frame, relation)
        6     !isempty(targets) && all(all(!isempty(collect(accessible(frame, w, r))) for w in worlds(frame)) for r in targets)
